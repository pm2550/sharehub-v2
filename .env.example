# ShareHub 环境配置示例
# 复制此文件为 .env 并填写实际值

# 安全配置（必填）
SESSION_SECRET=your-secret-key-here-change-this-to-random-string
ADMIN_TOKEN=your-admin-token-here-change-this

# AI 配置
A1111_API_URL=http://127.0.0.1:8188

# 数据库
DATABASE_PATH=/data/sharehub/data/app.db

# 媒体存储
MEDIA_DIR=/data/sharehub/data/media

# 网站标题
SITE_TITLE=ShareHub

# 速率限制
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_AI=3/minute
